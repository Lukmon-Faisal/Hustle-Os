# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" or direct connection string, port 5432 (or 6543 for pooled).
# Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Get this from the Anthropic Console: https://console.anthropic.com/settings/keys
# Used by the /businesses/{id}/ask endpoint. Without it that endpoint returns 500.
ANTHROPIC_API_KEY=XXXXXXXX

# --- WhatsApp ingestion (POST /whatsapp/webhook) ---------------------------
# Twilio Console -> Account Info -> Auth Token. When set, every inbound webhook
# is signature-verified. LEAVE IT SET IN PRODUCTION: without it the endpoint
# accepts any POST, and anyone who learns the URL can write transactions.
TWILIO_AUTH_TOKEN=

# Where to file messages from a phone number that isn't linked to any business.
# Must be a real business UUID (this schema has no integer ids) — copy one from
# GET /businesses. Keeps a live demo working when someone texts from an
# unregistered handset. Unset falls back to the lowest business id.
DEMO_BUSINESS_ID=
