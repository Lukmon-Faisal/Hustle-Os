# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" or direct connection string, port 5432 (or 6543 for pooled).
# Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
